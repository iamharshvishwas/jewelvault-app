# Dependencies
node_modules/

# Next.js build output (the static site lands in out/)
.next/
out/
*.tsbuildinfo

# Generated by Next.js (next dev, next build, next typegen); the docs say not to track it
next-env.d.ts

# Environment files: never commit secrets. An example file with no real values is the one allowed kind.
.env*
!.env*.example

# Test output
coverage/
test-results/
playwright-report/

# Work folders of the end-to-end lanes (scripts/e2e-lane.mjs, WEB00: logs, a pid file and .env.local with the lane's test logins and admin token) and of the verify logs
# (scripts/verify.mjs). Never committed.
.lanes/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
