{
  "name": "jewelvault",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-4028}",
    "build": "next build",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:changed": "node scripts/lane.mjs lint-changed",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lane": "node scripts/lane.mjs",
    "db:start": "node scripts/lane.mjs start",
    "db:stop": "node scripts/lane.mjs stop",
    "db:reset": "node scripts/lane.mjs reset",
    "db:test": "node scripts/lane.mjs test",
    "db:test:2": "node scripts/lane.mjs test2",
    "db:check": "bash scripts/check-migrations.sh",
    "verify": "node scripts/lane.mjs verify"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "jsbarcode": "^3.11.6",
    "lucide-react": "^1.7.0",
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.86.0",
    "react-to-print": "^3.0.5",
    "recharts": "^2.15.2",
    "sonner": "^1.7.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "pg": "^8.23.1",
    "postcss": "8.4.8",
    "prettier": "^3.5.3",
    "supabase": "2.120.0",
    "tailwindcss": "3.4.6",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
